{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon",
    "dev:worker": "nodemon --exec \"ts-node ./src/worker.ts\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "migrate": "ts-node src/db/cli.ts up",
    "rollback": "ts-node src/db/cli.ts down",
    "migrate:status": "ts-node src/db/cli.ts status",
    "migrate:new": "ts-node src/db/cli.ts new",
    "import-json": "ts-node src/db/import-json.ts",
    "stories": "ts-node src/scripts/categorizeStories.ts",
    "agent": "ts-node src/scripts/runAgent.ts",
    "db": "node dist/db/cli.js",
    "test:watch": "vitest",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.21.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.2",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "body-parser": "^2.2.0",
    "dayjs": "^1.11.11",
    "express": "^5.1.0",
    "pg": "^8.23.0"
  }
}
