{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon",
    "dev:worker": "nodemon --exec \"tsx ./src/worker.ts\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "migrate": "tsx src/db/cli.ts up",
    "rollback": "tsx src/db/cli.ts down",
    "migrate:status": "tsx src/db/cli.ts status",
    "migrate:new": "tsx src/db/cli.ts new",
    "refresh": "tsx src/sources/cli.ts refresh",
    "user:create": "tsx src/users/cli.ts create",
    "user:passwd": "tsx src/users/cli.ts passwd",
    "user:list": "tsx src/users/cli.ts list",
    "user:delete": "tsx src/users/cli.ts delete",
    "search": "tsx src/components/websearch/cli.ts",
    "db": "node dist/db/cli.js",
    "user": "node dist/users/cli.js",
    "sources": "node dist/sources/cli.js",
    "test:watch": "vitest",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.21.0",
    "nodemon": "^3.1.0",
    "tslib": "^2.6.2",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "body-parser": "^2.2.0",
    "dayjs": "^1.11.11",
    "express": "^5.1.0",
    "linkedom": "^0.18.13",
    "pg": "^8.23.0"
  }
}
